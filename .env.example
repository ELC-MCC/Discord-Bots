# --- Welcome Bot ---
WELCOME_BOT_TOKEN=
WELCOME_CHANNEL_ID=
GENERAL_CHANNEL_ID=
INTRODUCTIONS_CHANNEL_ID=
MAKER_GENERAL_CHANNEL_ID=

# --- Role Manager ---
ROLE_MANAGER_TOKEN=
MEMBER_ROLE_ID=

# --- Event Bot ---
EVENT_BOT_TOKEN=
EVENT_CHANNEL_ID=

# --- Stream Bot ---
STREAM_BOT_TOKEN=
STREAM_CHANNEL_ID=
STREAM_1_URL=http://.../api/stream.mjpeg?src=k2pro
STREAM_1_TITLE=Creality K2 Pro
# Optional. Blank means the stream posts to STREAM_CHANNEL_ID. Set it to put a
# stream in a different channel, e.g. the 3D Printed Wheelchair project channel.
# STREAM_1_CHANNEL_ID=
# STREAM_2_URL=
# STREAM_2_TITLE=
# STREAM_3_URL=
# STREAM_3_TITLE=

# printer api url (optional, defaults to stream url host:7125)
# PRINTER_1_URL=http://192.168.1.100:7125
# PRINTER_2_URL=

# --- Schedule Bot ---
SCHEDULE_BOT_TOKEN=your_schedule_bot_token_here

# --- Filament Bot ---
FILAMENT_BOT_TOKEN=your_filament_bot_token_here
FILAMENT_DATA_PATH=./data
FILAMENT_PUBLIC_CHANNEL_ID=
FILAMENT_ADMIN_CHANNEL_ID=

# --- Filament Bot: project pools ---
# One CHANNEL_ID and PIN per project, named after the project key in PROJECTS
# (bots/filament_bot.py). Adding a project means adding both lines for it.
# Dedicated channel for the project dashboard.
PROJECT_WHEELCHAIR_CHANNEL_ID=
# PIN required to log filament usage against the project. Server-side only: this
# value is never posted, embedded, or echoed back into Discord.
PROJECT_WHEELCHAIR_PIN=

# --- Announcement Bot ---
ANNOUNCEMENT_BOT_TOKEN=
# Optional. The admin panel sets the target channel and remembers it in the data
# file, so leave this blank unless you want a fallback for a fresh install.
# ANNOUNCEMENT_CHANNEL_ID=
# Optional. Where the queue and settings are stored. Relative paths resolve against
# the folder the bots run from (the repo root).
# ANNOUNCEMENT_DATA_PATH=./data
# Optional. Defaults to America/New_York, so typed times mean Eastern even if the
# server clock is set to UTC.
# ANNOUNCEMENT_TIMEZONE=America/New_York

# Universal Admin
ADMIN_CHANNEL_ID=
