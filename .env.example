# --- Announcement Bot ---
ANNOUNCEMENT_BOT_TOKEN=
# Optional. The admin panel sets the target channel and remembers it in the data
# file, so leave this blank unless you want a fallback for a fresh install.
# ANNOUNCEMENT_CHANNEL_ID=
# Optional. Where the queue and settings are stored. Relative paths resolve against
# the folder the bots run from (the repo root).
# ANNOUNCEMENT_DATA_PATH=./data
# Optional. Defaults to America/New_York, so typed times mean Eastern even if the
# server clock is set to UTC.
# ANNOUNCEMENT_TIMEZONE=America/New_York

# Universal Admin
ADMIN_CHANNEL_ID=
